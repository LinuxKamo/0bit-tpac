# =============================================================================
# TSHIMOLOGONG PLATFORM (TPAC) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control — it contains secrets.
# Variable NAMES are stable; only VALUES differ per environment.
# =============================================================================


# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Primary connection — goes through PgBouncer (pooled). Used by Prisma at runtime.
# Supabase format:
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL bypasses PgBouncer — required for Prisma migrations.
# Supabase format:
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Railway (auto-injected — Railway sets DATABASE_URL automatically):
#   DATABASE_URL=${{RAILWAY_DATABASE_URL}}
#
# AWS RDS (future migration target):
#   DATABASE_URL=postgresql://user:pass@xxx.rds.amazonaws.com:5432/tpac
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres


# ─── AUTH ─────────────────────────────────────────────────────────────────────
# JWT signing secret — must be at least 32 characters.
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars


# ─── URLS ─────────────────────────────────────────────────────────────────────
# Development defaults
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Production — update per deployment target:
#   Vercel (web):   FRONTEND_URL=https://tpac.tshimologong.co.za
#   Railway (API):  API_URL=https://tpac-api.railway.app
#   AWS API GW:     API_URL=https://xxx.execute-api.eu-west-1.amazonaws.com/prod


# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Authorised redirect URIs:
#   Dev:  http://localhost:3001/api/v1/auth/google/callback
#   Prod: https://tpac-api.railway.app/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ─── EMAIL ────────────────────────────────────────────────────────────────────
# Resend (recommended): https://resend.com
# Verify your sending domain in the Resend dashboard before going live.
RESEND_API_KEY=re_your_key_here
SENDER_EMAIL=noreply@tshimologong.co.za
EMAIL_FROM_NAME=The Tshimologong Platform Team

# Alternative providers — swap in your own mail service if needed:
#   SendGrid: use @sendgrid/mail npm package
#   AWS SES:  use @aws-sdk/client-ses npm package (preferred for AWS migration path)
#   Postmark: use postmark npm package


# ─── FILE STORAGE ─────────────────────────────────────────────────────────────
# Cloudflare R2 (recommended — S3-compatible, free egress):
# Create bucket at: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AWS S3 (target for Railway → AWS migration — uncomment and use instead of R2):
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_REGION=eu-west-1
#   AWS_S3_BUCKET=tpac-assets
#   AWS_CLOUDFRONT_DOMAIN=   (if using CloudFront CDN)

# Supabase Storage (simplest if already on Supabase — no extra vars needed,
# uses SUPABASE_URL + SUPABASE_SERVICE_KEY below):
#   SUPABASE_URL=https://[ref].supabase.co
#   SUPABASE_SERVICE_KEY=your-service-role-key


# ─── AI ───────────────────────────────────────────────────────────────────────
# Anthropic Claude — used for platform automation and content workers.
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here


# ─── SEED ─────────────────────────────────────────────────────────────────────
# Credentials used by `pnpm db:seed` to create the initial Super Admin account.
# This account is the only one created by code — all subsequent accounts are
# created through the platform UI.
# IMPORTANT: Change the password immediately after first login.
SEED_SUPER_ADMIN_EMAIL=superadmin@tshimologong.co.za
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@FirstLogin!


# ─── SERVER ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001


# =============================================================================
# RAILWAY — Production Variables
# =============================================================================
# Set these directly in the Railway service dashboard (not in .env):
#
#   DATABASE_URL        → auto-injected if using Railway Postgres plugin
#   JWT_SECRET          → generate with: openssl rand -base64 32
#   FRONTEND_URL        → your Vercel deployment URL
#   RESEND_API_KEY      → from resend.com dashboard
#   SENDER_EMAIL        → verified sending domain
#   NODE_ENV            → production
#
# =============================================================================
# VERCEL — Production Variables
# =============================================================================
# Set these in Vercel project → Settings → Environment Variables:
#
#   NEXT_PUBLIC_API_URL → your Railway API URL (e.g. https://tpac-api.railway.app/api/v1)
#
# =============================================================================
# GITHUB ACTIONS — CI/CD Secrets
# =============================================================================
# Add in: GitHub repo → Settings → Secrets and variables → Actions
#
#   DATABASE_URL        → same as production
#   JWT_SECRET          → same as production
#   NEXT_PUBLIC_API_URL → same as production
#   VERCEL_TOKEN        → vercel.com → Account Settings → Tokens
#   VERCEL_ORG_ID       → vercel.com → Team Settings → General
#   VERCEL_PROJECT_ID   → vercel.com → Project Settings → General
#   RAILWAY_TOKEN       → railway.app → Account → Tokens
# =============================================================================
