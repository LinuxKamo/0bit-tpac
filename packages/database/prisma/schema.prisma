// =============================================================================
// TSHIMOLOGONG PLATFORM (TPAC) — Prisma Schema
// =============================================================================
// Architecture: country-as-configuration. Every country is an independent
// configured instance sharing one codebase and one database. South Africa is
// the first active market; all other markets are pre-configured at Draft or
// Coming Soon and activated without code changes.
//
// Role hierarchy:
//   Super Admin → Admin → Manager → Corporate Admin → Mentor → Member
//
// Tier hierarchy (structural slots — names/prices configured per country):
//   EXPLORER → BUILDER → FOUNDER  (individual)
//   CORPORATE                      (B2B)
//   DIASPORA                       (Pan-African outside SA)
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CORPORATE_ADMIN
  MENTOR
  MEMBER
  DEVELOPER
  CLIENT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum CountryStatus {
  DRAFT // internal only — not visible to public
  COMING_SOON // public waitlist enabled
  ACTIVE // fully live
  INACTIVE // temporarily disabled
}

// Structural tier slots — names and prices are configured per country.
// The slot is the system identity; CountryTier holds the display config.
enum TierSlot {
  EXPLORER // free, top-of-funnel
  BUILDER // core paid individual tier
  FOUNDER // premium entrepreneur tier
  CORPORATE // B2B bulk seat tier
  DIASPORA // Pan-African outside SA
}

enum ProfileType {
  ENTREPRENEUR
  ALUMNI
}

enum ProgrammePhase {
  APPLICATION // accepting applications
  SELECTION // reviewing applicants
  ACTIVE // cohort is running
  DEMO_DAY // demo day imminent
  GRADUATED // cohort complete
}

enum EnrollmentType {
  OPEN // any eligible tier member can join directly
  APPLICATION // must apply and be selected
}

enum ScheduleType {
  ONE_TIME // runs once (e.g. Builders Residency annual)
  RECURRING // repeats on a cadence (e.g. Design Thinking monthly)
}

enum CourseStatus {
  DRAFT // being built
  IN_REVIEW // submitted for review
  APPROVED // reviewed and approved, ready to assign
  PUBLISHED // live — assigned to cohorts or tier library
  ARCHIVED // no longer in use
}

enum LessonType {
  READING
  DIALOG
  EXERCISE
  EXERCISE_ANSWER
  LAB
  SCRIPT
  QUESTIONNAIRE
  CASE_STUDY
  MCQ
  ASSESSMENT
  VIDEO
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum ContentType {
  COURSE
  WORKSHOP // scheduled live session
  CERTIFICATE // uploaded graduation certificate
}

enum EventType {
  PUBLIC // visible and open to all (including Explorer)
  MEMBER // requires any paid tier
  COHORT // attached to a programme cohort
  CORPORATE // corporate-scoped event
}

enum OpportunityType {
  JOB
  GIG
  FUNDING
  PARTNER_CHALLENGE
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PostStatus {
  PUBLISHED
  DRAFT
  FLAGGED
  REMOVED
}

enum RegistrationMode {
  INVITE_ONLY
  SELF_REGISTER
  SELF_REGISTER_AUTO
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  role          Role          @default(MEMBER)
  accountStatus AccountStatus @default(PENDING)

  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  phone       String?
  bio         String?

  // Auth tokens
  verificationCode     String?
  verificationExpires  DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastActiveAt         DateTime?

  // OAuth
  googleId           String? @unique
  googleRefreshToken String?

  // Invite chain — who created this account
  invitedById String?
  invitedBy   User?   @relation("UserInvites", fields: [invitedById], references: [id])
  invitees    User[]  @relation("UserInvites")

  // Country assignment — required for MEMBER, MENTOR, CORPORATE_ADMIN.
  // MANAGER uses the CountryManager join table (many-to-many); countryId is null for them.
  // ADMIN and SUPER_ADMIN are platform-global; countryId is always null for them.
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  // Corporate — Corporate Admin + seat holders
  organisationId String?
  organisation   Organisation? @relation("OrgMembers", fields: [organisationId], references: [id])

  // Profile extensions
  memberProfile MemberProfile?
  mentorProfile MentorProfile?

  // Relations
  managedCountries     CountryManager[]
  subscriptions        Subscription[]
  contentEnrollments   ContentEnrollment[]
  eventRegistrations   EventRegistration[]
  opportunityBookmarks OpportunityBookmark[]
  physicalBookings     PhysicalAccessBooking[]
  waitlistEntries      WaitlistEntry[]
  communityMemberships CommunityGroupMember[]
  posts                Post[]
  organisationSeats    OrganisationSeat[]
  cohortParticipations CohortParticipant[]
  createdCohorts       ProgrammeCohort[]       @relation("CohortCreator")
  cohortMentorships    CohortMentor[]          @relation("CohortMentors")
  createdCourses       Course[]                @relation("CourseCreator")
  reviewedCourses      Course[]                @relation("CourseReviewer")
  milestoneSubmissions MilestoneSubmission[]   @relation("MilestoneSubmissions")
  milestoneReviews     MilestoneSubmission[]   @relation("MilestoneReviews")
  mentorMatches        MentorMatch[]           @relation("MentorMatches")
  menteeMatches        MentorMatch[]           @relation("MenteeMatches")
  sessionsAsMentor     MentorSession[]         @relation("SessionMentor")
  sessionsAsMentee     MentorSession[]         @relation("SessionMentee")
  auditLogs            AuditLog[]
  notifications        Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([countryId])
  @@index([accountStatus])
  @@index([googleId])
  @@index([organisationId])
  @@index([invitedById])
}

// ─── Country ──────────────────────────────────────────────────────────────────
// The root configuration unit. Every country is a full platform instance.

model Country {
  id String @id @default(cuid())

  // Identity
  name           String
  code           String        @unique // ISO 3166-1 alpha-2 (e.g. "ZA", "KE", "NG")
  flagEmoji      String?
  currency       String // ISO 4217 (e.g. "ZAR", "USD", "KES")
  currencySymbol String? // display symbol (e.g. "R", "$", "KSh")
  timezone       String // IANA (e.g. "Africa/Johannesburg")
  status         CountryStatus @default(DRAFT)

  // Physical access — co-working (SA only at launch)
  physicalAccessEnabled Boolean @default(false)
  physicalLocation      String? // venue name
  physicalAddress       String? // full address

  // Payment gateway — per-country, not global
  paymentGateway    String? // "payfast" | "stripe" | "manual"
  paymentConfigJson Json? // gateway-specific keys/webhook secrets (encrypted at app layer)

  // Community configuration
  chapterName       String? // e.g. "Tshimologong Joburg"
  chapterLeadId     String? // User id of the chapter lead (Manager)
  showGlobalContent Boolean @default(true) // scaffold: show global library while local content is being built

  // Compliance
  complianceFramework String? // e.g. "BBBEE+ESD" | "local" | null
  taxConfigJson       Json? // flexible per-country tax config
  invoiceTemplateId   String?

  // Onboarding messaging
  waitlistMessage   String?
  onboardingMessage String?

  // Registration control
  registrationMode RegistrationMode @default(INVITE_ONLY)

  // Relations
  tiers            CountryTier[]
  managers         CountryManager[]
  members          User[]
  organisations    Organisation[]
  programmes       Programme[]
  events           Event[]
  opportunities    Opportunity[]
  communityGroups  CommunityGroup[]
  waitlistEntries  WaitlistEntry[]
  physicalBookings PhysicalAccessBooking[]
  invoices         Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([status])
}

// ── CountryManager (Country ↔ Manager many-to-many) ──────────────────────────

model CountryManager {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([countryId, userId])
  @@index([countryId])
  @@index([userId])
}

// ─── CountryTier ──────────────────────────────────────────────────────────────
// Admin configures one record per TierSlot per country.
// All pricing, names, and feature flags live here — nothing is hardcoded.

model CountryTier {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  slot          TierSlot // structural identity — unique per country
  name          String // display name (e.g. "Explorer", "Builder" — configurable)
  description   String?
  price         Decimal  @db.Decimal(10, 2) // 0.00 for free tiers
  billingCycle  String   @default("monthly") // "monthly" | "annual" | "custom"
  isActive      Boolean  @default(true)
  isRecommended Boolean  @default(false)
  sortOrder     Int      @default(0)

  // Feature allocations — stored as JSON so Admin can configure without migrations.
  // Example: { "coursesPerMonth": 1, "mentorSessions": 2, "communityAccess": true,
  //            "physicalDaysPerMonth": 0, "priorityMentorMatching": false }
  featuresJson Json?

  // Physical access (null = no physical access for this tier)
  guestDaysPerMonth Int?

  members       MemberProfile[]
  subscriptions Subscription[]
  tierCourses   TierCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, slot])
  @@index([countryId])
  @@index([isActive])
}

// ─── MemberProfile ────────────────────────────────────────────────────────────
// Member-specific data separated from User to keep User lean.

model MemberProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileType ProfileType  @default(ENTREPRENEUR)
  tierId      String?
  tier        CountryTier? @relation(fields: [tierId], references: [id])

  // Entrepreneur fields
  companyName    String?
  companyWebsite String?
  industry       String?
  stage          String? // "idea" | "mvp" | "revenue" | "scaling"

  // Public profile
  linkedinUrl String?
  twitterUrl  String?
  websiteUrl  String?
  skills      String[]
  interests   String[]

  // Usage counters — reset monthly by a background job
  coursesUsedThisMonth Int       @default(0)
  mentorSessionsUsed   Int       @default(0)
  lastUsageResetAt     DateTime?

  // Onboarding state
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tierId])
  @@index([profileType])
}

// ─── Organisation (Corporate / B2B accounts) ─────────────────────────────────

model Organisation {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  name     String
  logoUrl  String?
  website  String?
  industry String?
  size     String? // "1-10" | "11-50" | "51-200" | "200+"

  // Seat allocation
  totalSeats Int @default(0)
  usedSeats  Int @default(0)

  // Billing
  billingEmail       String?
  vatNumber          String?
  billingAddressJson Json?

  // Compliance (SA BBBEE / ESD)
  bbbeeLevel String?
  esdCertUrl String?

  members            User[]              @relation("OrgMembers")
  seats              OrganisationSeat[]
  invoices           Invoice[]
  cohortParticipants CohortParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

// ── OrganisationSeat ──────────────────────────────────────────────────────────

model OrganisationSeat {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  inviteEmail String? // pre-invite before user registers

  status      String    @default("pending") // "pending" | "active" | "revoked"
  activatedAt DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([userId])
  @@index([status])
}

// ─── MentorProfile ────────────────────────────────────────────────────────────
// Appointed from Alumni pool by Manager/Admin — cannot self-assign.

model MentorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public profile (visible to all members as a searchable resource)
  headline    String?
  expertise   String[]
  industries  String[]
  linkedinUrl String?
  calendlyUrl String? // booking link for self-scheduling

  // Availability config
  maxMentees       Int @default(3)
  sessionDuration  Int @default(60) // minutes per session
  sessionsPerMonth Int @default(4)

  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── MentorMatch ───────────────────────────────────────────────────────────────

model MentorMatch {
  id       String @id @default(cuid())
  mentorId String
  mentor   User   @relation("MentorMatches", fields: [mentorId], references: [id])
  menteeId String
  mentee   User   @relation("MenteeMatches", fields: [menteeId], references: [id])

  status    String    @default("pending") // "pending" | "active" | "ended"
  matchedBy String? // userId of the Manager/Admin who approved the match
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?

  sessions MentorSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mentorId, menteeId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

// ── MentorSession ─────────────────────────────────────────────────────────────

model MentorSession {
  id       String       @id @default(cuid())
  matchId  String?
  match    MentorMatch? @relation(fields: [matchId], references: [id])
  mentorId String
  mentor   User         @relation("SessionMentor", fields: [mentorId], references: [id])
  menteeId String
  mentee   User         @relation("SessionMentee", fields: [menteeId], references: [id])

  scheduledAt DateTime
  duration    Int // minutes
  status      SessionStatus @default(PENDING)

  agendaNotes  String? // shared notes before the session
  sessionNotes String? // mentor's post-session notes
  menteeRating Int? // 1–5 rating submitted by mentee after session

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Programme ────────────────────────────────────────────────────────────────
// Builders Residency and any future programme types.

model Programme {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  name        String
  description String?
  type        String  @default("BUILDERS_RESIDENCY")
  isActive    Boolean @default(true)

  // Tier eligibility — members at this slot or above can access
  minimumTierSlot TierSlot? // null = all tiers (including Explorer)

  // Enrollment model
  enrollmentType EnrollmentType @default(OPEN)

  // Scheduling
  scheduleType       ScheduleType @default(ONE_TIME)
  recurringFrequency String? // "monthly" | "quarterly" | "weekly" — only when RECURRING

  cohorts ProgrammeCohort[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([isActive])
  @@index([minimumTierSlot])
}

// ── ProgrammeCohort ───────────────────────────────────────────────────────────

model ProgrammeCohort {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  name               String // e.g. "Cohort 12 — Q1 2026"
  phase              ProgrammePhase @default(APPLICATION)
  applicationOpenAt  DateTime?
  applicationCloseAt DateTime?
  startDate          DateTime?
  endDate            DateTime?
  demoDayDate        DateTime?
  maxParticipants    Int?
  isRemote           Boolean        @default(false)

  // Corporate challenge brief (stored as JSON — flexible structure)
  corporateBriefJson Json?

  createdById String?
  createdBy   User?   @relation("CohortCreator", fields: [createdById], references: [id])

  participants  CohortParticipant[]
  cohortCourses CohortCourse[]
  cohortMentors CohortMentor[]
  milestones    CohortMilestone[]
  events        Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programmeId])
  @@index([phase])
}

// ── CohortParticipant ─────────────────────────────────────────────────────────

model CohortParticipant {
  id       String          @id @default(cuid())
  cohortId String
  cohort   ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id])

  // Can be independently sponsored by a corporate
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  status          String    @default("applied") // "applied" | "selected" | "active" | "graduated" | "withdrawn"
  applicationJson Json? // application form responses
  certificateUrl  String? // uploaded by Manager after graduation
  graduatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
  @@index([status])
}

// ─── Course Catalog ───────────────────────────────────────────────────────────
// Reusable courses built by mentors/managers/admins.
// A course lives in the global catalog and can be:
//   (a) assigned to a cohort  →  only cohort participants access it
//   (b) assigned to a tier    →  all members of that tier access it (library)

model Course {
  id           String       @id @default(cuid())
  title        String
  description  String?
  thumbnailUrl String?
  status       CourseStatus @default(DRAFT)
  sprintLabel  String       @default("Module") // "Module" | "Sprint" | "Week" etc.

  // Authorship
  createdById  String
  createdBy    User      @relation("CourseCreator", fields: [createdById], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("CourseReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  publishedAt  DateTime?

  modules       CourseModule[]
  cohortCourses CohortCourse[]
  tierCourses   TierCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

// ── CourseModule ──────────────────────────────────────────────────────────────
// Called "Sprint" in MaLern — renamed to Module for clarity.

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int     @default(0)

  lessons CourseLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([courseId, order])
}

// ── CourseLesson ──────────────────────────────────────────────────────────────

model CourseLesson {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title              String
  code               String // display code e.g. "R1", "V2", "MCQ3"
  type               LessonType
  order              Int        @default(0)
  isResource         Boolean    @default(false) // downloadable resource, not a step
  submissionRequired Boolean    @default(false)
  content            Json? // type-specific content (pdf url, youtube id, mcq questions etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([moduleId, order])
}

// ── CohortCourse ──────────────────────────────────────────────────────────────
// Links a published course to a cohort. Order controls curriculum sequence.

model CohortCourse {
  id       String          @id @default(cuid())
  cohortId String
  cohort   ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseId String
  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int             @default(0)

  assignedAt DateTime @default(now())

  @@unique([cohortId, courseId])
  @@index([cohortId])
  @@index([courseId])
}

// ── CohortMentor ──────────────────────────────────────────────────────────────
// Assigns a mentor/facilitator/assistant to a cohort.

model CohortMentor {
  id       String          @id @default(cuid())
  cohortId String
  cohort   ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation("CohortMentors", fields: [userId], references: [id], onDelete: Cascade)

  role String @default("mentor") // "facilitator" | "mentor" | "assistant"

  assignedAt DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

// ── CohortMilestone ───────────────────────────────────────────────────────────
// Checkpoints that cohort participants must reach.

model CohortMilestone {
  id       String          @id @default(cuid())
  cohortId String
  cohort   ProgrammeCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime?
  order       Int       @default(0)
  isRequired  Boolean   @default(true)
  submissionType String @default("FILE_UPLOAD")

  submissions MilestoneSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cohortId])
  @@index([cohortId, order])
}

// ── MilestoneSubmission ───────────────────────────────────────────────────────
// A participant's response to a milestone checkpoint.

model MilestoneSubmission {
  id          String          @id @default(cuid())
  milestoneId String
  milestone   CohortMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation("MilestoneSubmissions", fields: [userId], references: [id])

  status       MilestoneStatus @default(PENDING)
  note         String? // participant's submission note
  fileUrl      String? // optional uploaded file
  linkUrl      String? // optional link submission
  reviewNote   String? // reviewer's feedback
  reviewedById String?
  reviewedBy   User?           @relation("MilestoneReviews", fields: [reviewedById], references: [id])

  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([milestoneId, userId])
  @@index([milestoneId])
  @@index([userId])
  @@index([status])
}

// ── TierCourse ────────────────────────────────────────────────────────────────
// Makes a published course available to all members of a tier as a
// self-paced library course (not inside a cohort).

model TierCourse {
  id       String      @id @default(cuid())
  tierId   String
  tier     CountryTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  courseId String
  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([tierId, courseId])
  @@index([tierId])
  @@index([courseId])
}

// ─── Content (Courses & Workshops) ────────────────────────────────────────────

model Content {
  id           String      @id @default(cuid())
  type         ContentType
  title        String
  description  String?
  thumbnailUrl String?
  contentUrl   String? // file URL or external link
  duration     Int? // minutes

  // Access gating — null means accessible to all tiers
  minimumTierSlot TierSlot?
  isPublished     Boolean   @default(false)

  // For WORKSHOP type
  scheduledAt DateTime?
  hostId      String? // User id of the presenter

  enrollments ContentEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isPublished])
  @@index([minimumTierSlot])
  @@index([scheduledAt])
}

// ── ContentEnrollment ─────────────────────────────────────────────────────────

model ContentEnrollment {
  id        String  @id @default(cuid())
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  progress       Int       @default(0) // 0–100 percent
  completedAt    DateTime?
  certificateUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, userId])
  @@index([userId])
  @@index([contentId])
}

// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id        String           @id @default(cuid())
  countryId String
  country   Country          @relation(fields: [countryId], references: [id])
  cohortId  String?
  cohort    ProgrammeCohort? @relation(fields: [cohortId], references: [id])

  title        String
  description  String?
  type         EventType @default(PUBLIC)
  imageUrl     String?
  location     String? // physical address or "Online"
  streamUrl    String?
  startsAt     DateTime
  endsAt       DateTime?
  maxAttendees Int?
  isPublished  Boolean   @default(false)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([type])
  @@index([startsAt])
  @@index([isPublished])
}

// ── EventRegistration ─────────────────────────────────────────────────────────

model EventRegistration {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ─── Opportunity ──────────────────────────────────────────────────────────────

model Opportunity {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  type         OpportunityType
  title        String
  description  String?
  organisation String? // company or fund posting the opportunity
  url          String?
  deadline     DateTime?

  // null = visible to all tiers; set to restrict early access to higher tiers
  minimumTierSlot TierSlot?

  isPublished Boolean   @default(false)
  isPinned    Boolean   @default(false)
  expiresAt   DateTime?

  bookmarks OpportunityBookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([type])
  @@index([isPublished])
  @@index([deadline])
}

// ── OpportunityBookmark ───────────────────────────────────────────────────────

model OpportunityBookmark {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([opportunityId, userId])
  @@index([opportunityId])
  @@index([userId])
}

// ─── CommunityGroup ───────────────────────────────────────────────────────────

model CommunityGroup {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  name            String
  description     String?
  imageUrl        String?
  isPublic        Boolean   @default(true)
  minimumTierSlot TierSlot? // null = all tiers

  members CommunityGroupMember[]
  posts   Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

// ── CommunityGroupMember ──────────────────────────────────────────────────────

model CommunityGroupMember {
  id      String         @id @default(cuid())
  groupId String
  group   CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String         @default("member") // "member" | "moderator" | "lead"

  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ── Post ──────────────────────────────────────────────────────────────────────

model Post {
  id       String         @id @default(cuid())
  groupId  String
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId String
  author   User           @relation(fields: [authorId], references: [id])

  body       String
  imageUrls  String[]
  status     PostStatus @default(PUBLISHED)
  isPinned   Boolean    @default(false)
  flagReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

// ─── PhysicalAccessBooking (SA guest days) ───────────────────────────────────
// Members with eligible tiers book days at the Johannesburg precinct.

model PhysicalAccessBooking {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingDate DateTime
  status      String    @default("confirmed") // "confirmed" | "cancelled" | "no_show"
  checkedInAt DateTime?
  notes       String?

  createdAt DateTime @default(now())

  @@index([countryId])
  @@index([userId])
  @@index([bookingDate])
  @@index([status])
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId String
  tier   CountryTier @relation(fields: [tierId], references: [id])

  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  trialEndsAt        DateTime?

  // Payment provider reference
  providerRef  String? // Stripe or PayFast subscription ID
  providerName String? // "stripe" | "payfast"

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tierId])
  @@index([status])
}

// ─── Invoice ──────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  countryId      String
  country        Country       @relation(fields: [countryId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String
  status        PaymentStatus @default(PENDING)
  dueAt         DateTime?
  paidAt        DateTime?
  invoiceUrl    String? // generated PDF URL
  providerRef   String? // payment provider transaction ID
  lineItemsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([status])
  @@index([subscriptionId])
  @@index([organisationId])
}

// ─── WaitlistEntry ────────────────────────────────────────────────────────────
// Captures interest for Coming Soon countries — works for both registered
// users and anonymous visitors.

model WaitlistEntry {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  email     String // always captured, even for anonymous visitors

  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([countryId, email])
  @@index([countryId])
  @@index([notified])
}

// ─── FeatureFlag ──────────────────────────────────────────────────────────────
// Controlled by Super Admin. null countryId = global. Set countryId to scope
// a flag to a specific market.

model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?
  enabled     Boolean @default(false)
  countryId   String? // null = global flag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([enabled])
  @@index([countryId])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
// Every significant action logs: actor, action, entity, country context,
// old/new values, and timestamp. countryId is null for global actions
// (e.g. Super Admin creating an Admin, toggling a feature flag).

model AuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     String // verb.noun format: "admin.invite" | "tier.update" | "member.suspend"
  countryId  String? // null = global / platform-level action
  entityType String? // "user" | "country" | "tier" | "cohort" | "organisation" | "programme" etc.
  entityId   String? // id of the record that was acted on
  oldValue   Json? // snapshot before the change
  newValue   Json? // snapshot after the change
  meta       Json? // additional context that doesn't fit old/new (e.g. invite link sent)

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([countryId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── SystemSetting ────────────────────────────────────────────────────────────
// Key-value store for platform-wide configuration managed by Super Admin.

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
